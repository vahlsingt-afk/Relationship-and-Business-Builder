{
  "schema": "rb.hunter_playbook_registry.v1",
  "updated_at": "2026-10-02T00:00:00Z",
  "operating_policy": {
    "primary_mission": "Fill explicit gaps in RBB data, then discover material net-new restaurant and restaurant-technology intelligence.",
    "required_phases": [
      "baseline_existing_rbb_state",
      "known_gap_resolution",
      "net_new_discovery",
      "change_detection",
      "verification_and_disconfirmation",
      "mutation_proposal",
      "cos_synthesis_handoff",
      "validation"
    ],
    "completion_rule": "Every supplied gap must have an outcome, the discovery pass must be reported, and every material change must route to a mutation proposal, a CoS handoff, or both."
  },
  "depth_levels": {
    "scan": {
      "max_pages": 8,
      "target_minutes": 15,
      "minimum_independent_chains": 1,
      "description": "Recent signals and obvious gaps."
    },
    "standard": {
      "max_pages": 25,
      "target_minutes": 45,
      "minimum_independent_chains": 2,
      "description": "Complete current profile across required modules."
    },
    "deep": {
      "max_pages": 60,
      "target_minutes": 120,
      "minimum_independent_chains": 2,
      "description": "Multi-source present and historical reconstruction."
    },
    "forensic": {
      "max_pages": 100,
      "target_minutes": 240,
      "minimum_independent_chains": 3,
      "description": "Resolve disputed identity, scope, deployment, ownership, or lifecycle claims."
    },
    "monitor": {
      "max_pages": 15,
      "target_minutes": 30,
      "minimum_independent_chains": 1,
      "description": "Research only changes since the prior verified state."
    }
  },
